{
  "name": "resource-service",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run cp",
    "cp": "cp README.md LICENSE dist/resource",
    "publish": "npm run build && cd dist/resource && npm publish",
    "test": "ng test",
    "coverage": "ng test --watch=false --code-coverage && npm run serve:coverage",
    "serve:coverage": "pushstate-server ./coverage",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/common": ">=16.0",
    "@angular/compiler": ">=16.0",
    "@angular/core": ">=16.0",
    "@angular/platform-browser": ">=16.0",
    "@angular/platform-browser-dynamic": ">=16.0",
    "@angular/router": ">=16.0",
    "rxjs": ">=7.0",
    "zone.js": ">=0.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": ">=0.16",
    "@angular/cli": ">=16.0",
    "@types/jasmine": ">=5.0.0",
    "@types/node": "~8.9.4",
    "husky": "^1.3.1",
    "jasmine-core": "^5.5.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-coverage-istanbul-reporter": "^2.1.0",
    "karma-jasmine": ">=5.0.0",
    "karma-jasmine-html-reporter": ">=2.1.0",
    "karma-mocha-reporter": "^2.2.5",
    "ng-packagr": "^19.2.2",
    "prettier": "^3.6.1",
    "pretty-quick": "^4.2.2",
    "tslib": ">=2.3.0",
    "tslint": "^5.20.0",
    "typescript": ">=5.0.0"
  }
}
